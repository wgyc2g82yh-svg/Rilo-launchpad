# Create a Supabase project, then add these values to .env.local.
# Keep the service role key secret. Never expose it as a NEXT_PUBLIC variable.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only Solana RPC, such as your Helius endpoint. Do not use NEXT_PUBLIC.
# Scans stay unavailable until a real endpoint is configured.
SOLANA_RPC_URL=

# The exact public app origin, e.g. https://riloprotocol.xyz (without /app).
APP_ORIGIN=
# Random server-only secret of at least 32 characters. Generate using your
# hosting secret manager or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SIGNING_SECRET=

# Jupiter key is optional for limited quote-only prototyping; use a production
# key for a public launch. No signing keys belong on the server.
JUPITER_API_KEY=
# Optional registered Jupiter referral account and explicit fee in basis points.
JUPITER_REFERRAL_ACCOUNT=
JUPITER_REFERRAL_FEE_BPS=

# Public wallet/config addresses. Set the treasury before initializing the curve
# from the Launch page's fee engine. Set the resulting config after confirmation.
RILO_TREASURY_ADDRESS=
RILO_DBC_CONFIG=
RILO_TOKEN_MINT=
TOKEN_METADATA_BUCKET=token-metadata

# Keep false during configuration and devnet testing. Mainnet actions are gated.
ENABLE_MAINNET_TRANSACTIONS=false
